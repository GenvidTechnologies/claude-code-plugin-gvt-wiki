{
  "project": {
    "name": "gvt-wiki",
    "description": "The gvt-wiki Claude Code plugin: the maintain-wiki skill, wiki-lint and wiki hooks.",
    "languages": ["javascript"]
  },
  "commands": {
    "test": "npm ci --prefix plugin --ignore-scripts --no-audit --no-fund && node --test plugin/skills/maintain-wiki/scripts/test/*.test.mjs plugin/hooks/test/*.test.mjs",
    "validate": "bash .github/scripts/leak-guard.sh && npm ci --prefix plugin --ignore-scripts --no-audit --no-fund && claude plugin validate plugin && node --test plugin/skills/maintain-wiki/scripts/test/*.test.mjs plugin/hooks/test/*.test.mjs"
  },
  "repo": {
    "default_branch": "main",
    "host": "github",
    "owner": "GenvidTechnologies",
    "name": "claude-code-plugin-gvt-wiki"
  },
  "paths": {
    "plugin_root": "plugin"
  },
  "bugTracker": {
    "kind": "github",
    "actionQuery": "gh issue list --state open -L 500 --json number,title,labels,body,assignees,author,createdAt,milestone",
    "comparisonQuery": "gh issue list --state all -L 1000 --json number,title,labels,state",
    "readOne": "gh issue view {id} --json number,title,body,labels,comments",
    "commentsQuery": "gh issue list --state open -L 500 --json number,comments",
    "structureQuery": "gh issue list --state open -L 500 --json number,parent,subIssuesSummary",
    "refStateQuery": "gh api repos/{repo}/issues/{id} --jq '{number,state,state_reason,closed_at,pull_request:(.pull_request != null),sub_issues_summary}'",
    "triagedLabel": "triaged",
    "needsInfoLabel": "needs-info"
  }
}
